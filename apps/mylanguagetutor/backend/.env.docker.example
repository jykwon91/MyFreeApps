# Docker environment template -- consumed by docker-compose.yml `env_file:` directive
# for the migrate and api services. Seed it (plus the compose-level .env) on the VPS:
#   cd /srv/myfreeapps && PYTHONPATH=packages/shared-backend python3 -m platform_shared.infra.seed_env --app mylanguagetutor
#
# DATABASE_URL is set via docker-compose.yml `environment:` block -- do NOT set it here.
# DB_PASSWORD lives in apps/mylanguagetutor/.env (same dir as docker-compose.yml) -- do NOT set it here.

# Deployment environment -- controls Sentry enforcement.
# Set to "production" in prod deployments; SENTRY_DSN becomes REQUIRED.
# Leave as "development" or "test" for local/CI environments.
ENVIRONMENT=production

# Sentry DSN -- required when ENVIRONMENT=production. Boot fails loud if missing.
SENTRY_DSN=

SECRET_KEY=change-me-to-random-64-chars
ENCRYPTION_KEY=change-me-to-random-64-chars

# Multi-user app -- accounts are created via the public /auth/register route.
# New accounts must verify their email before first login (see EMAIL_* below).
# All tutor session data is scoped per-user.

# Boot-seeded platform admin (REQUIRED in production -- boot fails loud while
# blank). At every startup the app ensures a verified admin (role=admin +
# is_superuser) exists for SEED_ADMIN_EMAIL; the address is reserved from
# public registration. If a user with this email already exists it is promoted
# ONLY when its stored password hash matches SEED_ADMIN_PASSWORD_HASH exactly
# (anti account-squatting). Generate the bcrypt hash locally -- the password
# never leaves your terminal and must never be pasted anywhere:
#   python -c "from passlib.context import CryptContext; import getpass; print(CryptContext(schemes=['bcrypt']).hash(getpass.getpass('password: ')))"
# No-SSH path: set the MYLANGUAGETUTOR_SEED_ADMIN_EMAIL / MYLANGUAGETUTOR_SEED_ADMIN_PASSWORD_HASH
# repo secrets and dispatch the "Seed VPS env files" workflow.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD_HASH=

# --- The tutor (Claude) ---
# REQUIRED in production -- the lifespan fails loud (ExtractionNotConfiguredError)
# while blank. Use a key from a dedicated Anthropic workspace and set a
# ~$20/month spend limit on it in the Anthropic console (the belt to the
# LTUTOR_* caps' braces).
ANTHROPIC_API_KEY=

# Models -- overridable without a code change. Reply = streamed spoken text
# (latency-critical); corrections = structured JSON; translation = the English
# gloss shown under each tutor bubble.
LTUTOR_REPLY_MODEL=claude-haiku-4-5
LTUTOR_CORRECTIONS_MODEL=claude-sonnet-5
LTUTOR_TRANSLATION_MODEL=claude-haiku-4-5

# Daily cost caps in cost units (1 unit = one uncached Haiku 4.5 input token,
# $0.000001). Math in app/core/config.py. 650,000/day ~= $20/month for the
# whole app; 250,000/user/day ~= 30 turns. GLOBAL=0 is the kill switch (every
# turn -> 503 tutor_unavailable).
LTUTOR_USER_DAILY_UNITS=250000
LTUTOR_GLOBAL_DAILY_UNITS=650000
# Model price relative to Haiku 4.5 input. Re-check against current pricing.
LTUTOR_CORRECTIONS_UNIT_WEIGHT=2.0

# Frontend / CORS
FRONTEND_URL=https://mylanguagetutor.myfreeapps.org
CORS_ORIGINS=["https://mylanguagetutor.myfreeapps.org"]

# JWT
JWT_LIFETIME_SECONDS=1800
LOG_LEVEL=INFO

# HIBP compromised-password check -- leave true in prod
HIBP_ENABLED=true

# Cloudflare Turnstile CAPTCHA -- enforced on registration AND forgot-password.
# TURNSTILE_SITE_KEY is the public key inlined into the frontend bundle at build
# time (see docker/caddy.Dockerfile ARG + docker-compose build args); the widget
# renders on the Register + ForgotPassword pages. require_turnstile is a no-op
# when TURNSTILE_SECRET_KEY is empty (dev/CI), so leave both blank locally.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# Account-level login lockout
LOCKOUT_THRESHOLD=5
LOCKOUT_AUTORESET_HOURS=24

# Per-IP login throttle
LOGIN_RATE_LIMIT_THRESHOLD=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Email delivery
#
# Production MUST use EMAIL_BACKEND=smtp with valid SMTP_USER /
# SMTP_PASSWORD -- the platform_shared boot guard crashes the lifespan
# if EMAIL_BACKEND=console in non-development environments.
#
# For local dev / CI, set EMAIL_BACKEND=console and leave SMTP_* empty.
EMAIL_BACKEND=smtp
EMAIL_FROM_NAME=MyLanguageTutor
EMAIL_FROM_ADDRESS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# MinIO storage -- shared infra stack at infra/docker-compose.yml.
# Bucket mylanguagetutor-uploads auto-creates on backend lifespan startup.
MINIO_ENDPOINT=myfreeapps-minio:9000
MINIO_PUBLIC_ENDPOINT=https://storage.myfreeapps.org
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mylanguagetutor-uploads
MINIO_SECURE=false

# --- Cost-transparency / Support page (platform-wide, shared) ---
# The public /support page shows platform-wide monthly server costs vs Ko-fi
# donations. ONE app — MyBookkeeper — is the designated primary writer: it
# receives the Ko-fi webhook and runs the daily cost-sync loop, writing a single
# shared object that every app's /support widget reads. Set TRANSPARENCY_PRIMARY=true
# + KOFI_VERIFICATION_TOKEN + the cost values on MyBookkeeper ONLY; every other app
# leaves all of these at their defaults and only reads. See
# platform_shared/services/transparency.
#
# Ko-fi webhook verification token (Ko-fi dashboard → Webhooks → Verification token).
# Required on the primary in production; empty elsewhere (those apps 404 the
# webhook so misrouted posts stop retrying).
KOFI_VERIFICATION_TOKEN=

# Optional Anthropic Admin API key (sk-ant-admin...) so the daily sync pulls real
# Claude API spend into the cost figure. Primary only; empty → Claude spend = 0
# and only the fixed VPS + domain costs below are shown.
ANTHROPIC_ADMIN_API_KEY=
# Fixed monthly infrastructure costs, in integer USD cents (primary only).
# e.g. 1200 = $12.00/mo. Both default to 0.
VPS_MONTHLY_COST_CENTS=0
DOMAIN_MONTHLY_COST_CENTS=0
# Marks the single writer app. EXACTLY ONE app (MyBookkeeper) sets this true in
# production; all others stay false. The Ko-fi recording + asyncio daily cost-sync
# loop only run when true.
TRANSPARENCY_PRIMARY=false
# Shared MinIO bucket holding the one transparency object every app reads. Must be
# identical across all apps; the operator creates it once and grants each app's
# MinIO user access (operational migration). Defaults to myfreeapps-shared.
TRANSPARENCY_SHARED_BUCKET=myfreeapps-shared
