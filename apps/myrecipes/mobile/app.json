{
  "expo": {
    "name": "MyRecipes",
    "slug": "myrecipes",
    "scheme": "myrecipes",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "config": { "usesNonExemptEncryption": false },
      "bundleIdentifier": "org.myfreeapps.myrecipes"
    },
    "android": {
      "allowBackup": false,
      "package": "org.myfreeapps.myrecipes",
      "permissions": ["android.permission.SCHEDULE_EXACT_ALARM"]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      ["expo-notifications", { "enableRemoteNotifications": false }],
      ["expo-local-authentication", { "faceIDPermission": "I use Face ID to confirm it's you before changing your sign-in security." }]
    ]
  }
}
