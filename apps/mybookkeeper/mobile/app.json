{
  "expo": {
    "name": "MyBookkeeper",
    "slug": "mybookkeeper",
    "scheme": "mybookkeeper",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "org.myfreeapps.mybookkeeper"
    },
    "android": {
      "allowBackup": false,
      "package": "org.myfreeapps.mybookkeeper"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "I need camera access to read your receipts.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "I need your photos to read the receipts you choose.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "I use Face ID to confirm it's you before showing an applicant's private details."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ed617516-bb87-453f-8ff8-465e7402d265"
      }
    },
    "owner": "jykwon91"
  }
}
