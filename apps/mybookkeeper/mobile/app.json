{
  "expo": {
    "name": "MyBookkeeper",
    "slug": "mybookkeeper",
    "scheme": "mybookkeeper",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      },
      "bundleIdentifier": "org.myfreeapps.mybookkeeper"
    },
    "android": {
      "allowBackup": false,
      "package": "org.myfreeapps.mybookkeeper"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ed617516-bb87-453f-8ff8-465e7402d265"
      }
    },
    "owner": "jykwon91"
  }
}
