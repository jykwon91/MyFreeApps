{
  "expo": {
    "name": "MyJobHunter",
    "slug": "myjobhunter",
    "scheme": "myjobhunter",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "config": { "usesNonExemptEncryption": false },
      "bundleIdentifier": "org.myfreeapps.myjobhunter"
    },
    "android": {
      "allowBackup": false,
      "package": "org.myfreeapps.myjobhunter"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      ["expo-local-authentication", { "faceIDPermission": "I use Face ID to confirm it's you before changing your sign-in security." }]
    ]
  }
}
