{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "testflight": {
      "autoIncrement": true,
      "ios": { "resourceClass": "default" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "resourceClass": "default" }
    },
    "apk": {
      "android": { "buildType": "apk" },
      "distribution": "internal"
    }
  },
  "submit": {
    "testflight": {},
    "production": {}
  }
}
