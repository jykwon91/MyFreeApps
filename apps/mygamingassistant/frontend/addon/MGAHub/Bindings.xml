<!-- Key bindings for the MGA hub (MGAHub.lua). Only this addon declares them: the client loads every
     installed addon's Bindings.xml, and a binding name declared twice is an error at load. -->
<Bindings>
  <Binding name="MGA_MENU" header="MGA" category="MGA">
    if MGAHub then MGAHub.OpenMenu() end
  </Binding>
  <Binding name="MGA_SETTINGS" category="MGA">
    if MGAHub then MGAHub.OpenSettings() end
  </Binding>
</Bindings>
