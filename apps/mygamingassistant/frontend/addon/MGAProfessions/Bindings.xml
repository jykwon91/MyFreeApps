<!-- MGA Professions' own key binding. The MGA menu and settings bindings live only in the MGAHub addon's
     Bindings.xml: a binding name may be declared by one loaded addon only. -->
<Bindings>
  <Binding name="MGA_PROFESSIONS" category="MGA">
    if MGAProfessions then MGAProfessions.Toggle() end
  </Binding>
</Bindings>
