<!-- Key bindings for the MGA hub (MGAHub.lua) plus this addon's own. The first two bindings are the shared
     file's (addon/shared/Bindings.xml) byte for byte; a test keeps them in step. MGA_PROFESSIONS is only here. -->
<Bindings>
  <Binding name="MGA_MENU" header="MGA" category="MGA">
    if MGAHub then MGAHub.OpenMenu() end
  </Binding>
  <Binding name="MGA_SETTINGS" category="MGA">
    if MGAHub then MGAHub.OpenSettings() end
  </Binding>
  <Binding name="MGA_PROFESSIONS" category="MGA">
    if MGAProfessions then MGAProfessions.Toggle() end
  </Binding>
</Bindings>
