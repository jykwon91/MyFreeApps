<!-- Key bindings for the MGA hub (MGAHub.lua). SOURCE OF TRUTH: copied byte for byte into every
     MGA addon folder, like MGAHub.lua; the client loads a folder's Bindings.xml by itself. -->
<Bindings>
  <Binding name="MGA_MENU" header="MGA" category="MGA">
    if MGAHub then MGAHub.OpenMenu() end
  </Binding>
  <Binding name="MGA_SETTINGS" category="MGA">
    if MGAHub then MGAHub.OpenSettings() end
  </Binding>
</Bindings>
