{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "rootDir": "../../..",
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "postcss.config.js",
    "src/constants/linkPreview.ts",
    "src/games/registry.ts",
    "src/types/game.ts",
    "../../../packages/shared-frontend/src/vite/linkPreview/**/*.ts"
  ]
}
