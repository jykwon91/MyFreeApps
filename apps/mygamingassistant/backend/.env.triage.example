# Local config for the triage CLI (python -m scripts.wow_feature_triage).
# Copy to backend/.env.triage (gitignored) and fill in. Never paste the token
# in chat. It must equal one token in the server's WOW_FEATURE_TRIAGE_TOKEN
# (just the token part, without the "label:" prefix).
# https:// is required for anything but localhost.
MGA_TRIAGE_BASE_URL=https://mygamingassistant.myfreeapps.org/api
MGA_TRIAGE_TOKEN=
